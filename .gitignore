# Build output
/build/
/dist/
/wheelhouse/
*.pyd
*.dll
*.lib
*.exp
*.obj
*.pdb
*.ilk

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.vcxproj
*.vcxproj.filters
*.sln

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/.venv/
/venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv
# uv.lock IS committed. The C++ half is pinned by CMake and the compiler flags, so
# leaving the Python half to resolve fresh on every clone was the only thing making
# a build unreproducible.

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Scratch: screenshots and captures produced while testing the harness.
# These are pictures of the developer's actual desktop -- never commit them.
/scratch/
/captures/
*.jpg
*.jpeg
*.png
*.bmp
.mutation-in-progress

# Built into the plugin by CMake, never committed: a stale copy would silently
# serve older capture code than the source says.
plugin/bin/cufast.exe

# Also written by the build: the absolute path of the interpreter that has cufast
# installed, so the shim still finds it after the plugin is copied into
# ~/.claude/plugins/cache. Names a directory on one machine.
plugin/bin/interpreter.txt

# Written by pytest-cov when measuring coverage. A local artifact, and it
# embeds absolute paths from the machine that produced it.
.coverage
.coverage.*
htmlcov/

# CI writes these at the repo root to derive the badge numbers; artifacts, not
# source. Anchored with a leading slash: unanchored, "coverage.json" also matches
# .github/badges/coverage.json, which is the badge itself and must be committed.
/results.xml
/coverage.json
